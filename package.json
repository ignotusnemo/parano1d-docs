{
  "name": "parano1d-docs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-content.mjs && next dev",
    "build": "node scripts/generate-content.mjs && node scripts/validate-locales.mjs && next build && node scripts/postprocess-locales.mjs",
    "build:worker": "npm run build && node scripts/package-static-worker.mjs",
    "preview": "npm run build:worker && wrangler dev",
    "sync": "node scripts/sync-content.mjs && node scripts/generate-content.mjs",
    "generate": "node scripts/generate-content.mjs",
    "typecheck": "tsc --noEmit",
    "validate:seo": "node scripts/validate-seo.mjs",
    "validate:locales": "node scripts/validate-locales.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "markdown-it": "15.0.0",
    "markdown-it-anchor": "9.2.1",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@types/markdown-it": "14.1.2",
    "@types/node": "22.18.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "wrangler": "4.116.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "esbuild": "0.28.1",
    "minimatch": "10.2.6",
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "undici": "7.29.0",
    "ws": "8.21.1"
  }
}
